{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.stealthrdp.com/ai-seo/AISEO-V1-observation-schema.json",
  "title": "StealthRDP AI SEO V1 observation",
  "description": "Observation record for one frozen Core prompt, one surface, and one independent sample.",
  "type": "object",
  "required": [
    "prompt_id",
    "prompt_version",
    "sample_id",
    "sample_time_utc",
    "surface",
    "model_or_mode",
    "locale",
    "web_search_state",
    "complete_answer",
    "brand_mentioned",
    "brand_recommended",
    "brand_position",
    "own_source_used",
    "own_source_cited",
    "own_cited_urls",
    "competitors_mentioned",
    "competitors_recommended",
    "competitor_positions",
    "competitors_cited",
    "retrieved_sources",
    "visible_citations",
    "fanout_queries",
    "missing_information",
    "possible_gap",
    "annotator_confidence",
    "raw_capture_reference"
  ],
  "properties": {
    "prompt_id": {
      "type": "string",
      "pattern": "^CB1-[A-Z0-9]+$"
    },
    "prompt_version": {
      "const": "1.0"
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "sample_time_utc": {
      "type": "string",
      "format": "date-time"
    },
    "surface": {
      "type": "string",
      "enum": [
        "google_ai_overviews_ai_mode",
        "chatgpt_search",
        "bing_copilot",
        "perplexity"
      ]
    },
    "model_or_mode": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "const": "en-US"
    },
    "web_search_state": {
      "type": "string",
      "enum": [
        "ENABLED",
        "DISABLED",
        "UNKNOWN",
        "UNSUPPORTED"
      ]
    },
    "capture_status": {
      "type": "string",
      "enum": [
        "CAPTURED",
        "NO_AI_ANSWER",
        "UNSUPPORTED",
        "BLOCKED",
        "FAILED",
        "SKIPPED"
      ]
    },
    "unsupported_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "complete_answer": {
      "type": [
        "string",
        "null"
      ]
    },
    "brand_mentioned": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "brand_recommended": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "brand_position": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "own_source_used": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "own_source_cited": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "own_cited_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "competitors_mentioned": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "competitors_recommended": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "competitor_positions": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 1
      }
    },
    "competitors_cited": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retrieved_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "visible_citations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "fanout_queries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "possible_gap": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "gap_type": {
          "type": "string",
          "enum": [
            "CITATION_GAP",
            "CONTENT_GAP",
            "ENTITY_GAP",
            "NO_GAP",
            "UNKNOWN"
          ]
        },
        "detail": {
          "type": "string"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      },
      "required": [
        "gap_type",
        "detail",
        "confidence"
      ],
      "additionalProperties": true
    },
    "annotator_confidence": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "high",
        "medium",
        "low",
        null
      ]
    },
    "raw_capture_reference": {
      "type": "object",
      "required": [
        "storage_path",
        "sha256"
      ],
      "properties": {
        "storage_path": {
          "type": "string"
        },
        "line_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "page_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "selector": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "raw_ai_html_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "raw_page_text_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": true
    },
    "claim_volatility": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "VOLATILE",
        null
      ]
    },
    "current_evidence_checked_at_utc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "error_message": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "url",
        "source_role",
        "source_type",
        "target_alignment"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "resolved_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "domain": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_role": {
          "type": "string",
          "enum": [
            "OWNED",
            "EARNED",
            "SHARED"
          ]
        },
        "source_type": {
          "type": "string",
          "enum": [
            "OWN_SITE",
            "COMPETITOR",
            "EDITORIAL",
            "REVIEW",
            "COMMUNITY",
            "VIDEO",
            "DIRECTORY",
            "PARTNER",
            "REFERENCE",
            "OTHER"
          ]
        },
        "target_alignment": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "PREFERRED",
            "VALID_OTHER",
            "STALE_OR_WRONG",
            null
          ]
        },
        "visible": {
          "type": "boolean"
        },
        "ordinal": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
