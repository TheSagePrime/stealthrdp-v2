# Local development: pnpm dev starts PGlite and supplies the local PostgreSQL endpoint.
# Production: set DATABASE_URL in Coolify to the Neon PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/web_starter

NEXT_PUBLIC_APP_URL=http://localhost:3000
SITE_URL=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1

# Optional client/server observability. Privacy-sensitive features default off.
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_REPLAY_ENABLED=false
SENTRY_SOURCE_MAP_UPLOAD_ENABLED=false

# Server-only logging. Never expose these with NEXT_PUBLIC_ prefixes.
BETTER_STACK_INGESTING_URL=
BETTER_STACK_SOURCE_TOKEN=
LOGGING_LEVEL=info
