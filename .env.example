# Local development: pnpm dev starts PGlite and supplies the local PostgreSQL endpoint.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stealthrdp_v2

NEXT_PUBLIC_APP_URL=http://localhost:3000
SITE_URL=http://localhost:3000
APP_ENV=development
NEXT_TELEMETRY_DISABLED=1

# Preview (Coolify, branch redesign/homepage-production-parity):
# SITE_URL=https://preview.antah.de
# APP_ENV=preview
#
# Production (Vercel project stealthrdp-v2, branch main):
# SITE_URL=https://www.stealthrdp.com
# APP_ENV=production

NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_REPLAY_ENABLED=false
SENTRY_SOURCE_MAP_UPLOAD_ENABLED=false

BETTER_STACK_INGESTING_URL=
BETTER_STACK_SOURCE_TOKEN=
LOGGING_LEVEL=info