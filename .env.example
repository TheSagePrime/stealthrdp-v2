# Local development: pnpm dev starts PGlite and supplies the local PostgreSQL endpoint.
# Production: set DATABASE_URL in Coolify to the Neon PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sage_prime_starter

CLERK_SECRET_KEY=sk_test_replace-with-a-real-key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-with-a-real-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_REPLAY_ENABLED=false
SITE_URL=http://localhost:3000

# Polar remains disabled until the access token and an explicit product allowlist are configured.
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_IDS=
POLAR_SERVER=sandbox
POLAR_SUCCESS_URL=http://localhost:3000/dashboard
POLAR_PORTAL_RETURN_URL=http://localhost:3000/dashboard
POLAR_WEBHOOK_SECRET=

# Server-only logging. Never expose these with NEXT_PUBLIC_ prefixes.
BETTER_STACK_INGESTING_URL=
BETTER_STACK_SOURCE_TOKEN=
LOGGING_LEVEL=info
