# Local development: pnpm dev starts PGlite and supplies the local PostgreSQL endpoint.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stealthrdp_v2

NEXT_PUBLIC_APP_URL=http://localhost:3000
SITE_URL=http://localhost:3000
APP_ENV=development
NEXT_TELEMETRY_DISABLED=1

# Preview (Coolify, branch redesign/homepage-production-parity):
# SITE_URL=https://preview.antah.de
# APP_ENV=preview
#
# Production (Vercel project stealthrdp-v2, branch main):
# SITE_URL=https://www.stealthrdp.com
# APP_ENV=production

NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_REPLAY_ENABLED=false
SENTRY_SOURCE_MAP_UPLOAD_ENABLED=false

BETTER_STACK_INGESTING_URL=
BETTER_STACK_SOURCE_TOKEN=
LOGGING_LEVEL=info

# UptimeRobot read-only API key for /status (server only; set in Vercel production).
# Without it, /status reads the public status page feed.
# UPTIMEROBOT_API_KEY=

# Citadel customer dashboard and sign-in (server only).
# SESSION_SECRET: base64-encode 32 cryptographically random bytes, e.g. openssl rand -base64 32.
# It seals the 15-minute dashboard session and the 10-minute sign-in transaction cookie.
SESSION_SECRET=
# Production defaults to https://citadel.stealthrdp.com. Preview requires a separate HTTPS staging origin.
CITADEL_API_BASE_URL=
# Citadel identity is owned by WHMCS through OpenID Connect (authorization code + S256 PKCE).
# The redirect URI must match the URI registered on the WHMCS client byte for byte. It defaults to
# SITE_URL plus /api/citadel/auth/callback, for example https://preview.antah.de/api/citadel/auth/callback.
WHMCS_OIDC_ISSUER=https://dash.stealthrdp.com
WHMCS_OIDC_CLIENT_ID=
WHMCS_OIDC_CLIENT_SECRET=
CITADEL_LOGIN_REDIRECT_URI=
# Operator-only bridge that turns a verified WHMCS email into a user-scoped Citadel credential.
# Production platform keys must never be installed in preview or local. A non-production
# environment also needs CITADEL_PLATFORM_KEY_ALLOW_NON_PRODUCTION=true with its own staging key.
CITADEL_PLATFORM_API_KEY=
CITADEL_PLATFORM_KEY_ALLOW_NON_PRODUCTION=
