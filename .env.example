# Local development: pnpm dev starts PGlite and supplies the local PostgreSQL endpoint.
# Production: set DATABASE_URL in Coolify to the Neon PostgreSQL connection string.
# Production: set this to the Neon PostgreSQL connection string in Coolify.
# Local development uses the PGlite server started by pnpm dev/build-local.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sage_prime_starter
CLERK_SECRET_KEY=sk_test_replace-with-a-real-key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-with-a-real-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
SITE_URL=http://localhost:3000
POLAR_ACCESS_TOKEN=
POLAR_SERVER=sandbox
POLAR_SUCCESS_URL=http://localhost:3000/dashboard
POLAR_WEBHOOK_SECRET=
