{
  "schemaVersion": 1,
  "name": "Sage Prime frontend design contract",
  "componentSystem": {
    "name": "shadcn/ui",
    "configFile": "components.json",
    "style": "new-york",
    "uiAlias": "@/components/ui",
    "iconLibrary": "lucide",
    "primitiveRoot": "src/components/ui",
    "reservedPrimitiveFiles": [
      "button.tsx",
      "badge.tsx",
      "separator.tsx",
      "dropdown-menu.tsx",
      "input.tsx",
      "textarea.tsx",
      "select.tsx",
      "dialog.tsx",
      "card.tsx",
      "tabs.tsx",
      "tooltip.tsx",
      "accordion.tsx",
      "button-group.tsx"
    ],
    "registryPolicy": {
      "officialShadcnAllowed": true,
      "openSourceDirectoryAllowed": true,
      "reviewThirdPartyCodeBeforeUse": true,
      "forbidSecondGeneralPurposeUiKit": true
    }
  },
  "tokens": {
    "source": "src/styles/global.css",
    "required": [
      "--background",
      "--foreground",
      "--primary",
      "--primary-foreground",
      "--secondary",
      "--secondary-foreground",
      "--muted",
      "--muted-foreground",
      "--accent",
      "--accent-foreground",
      "--destructive",
      "--border",
      "--input",
      "--ring"
    ],
    "hardcodedColorAllowedPaths": [
      "src/styles/global.css"
    ]
  },
  "allowedIconPackages": [
    "@phosphor-icons/react",
    "@hugeicons/react",
    "@hugeicons/core-free-icons",
    "@icons-pack/react-simple-icons"
  ],
  "legacyIconPackages": [
    "lucide-react"
  ],
  "forbiddenUiPackages": [
    "@fortawesome/fontawesome-svg-core",
    "@fortawesome/free-solid-svg-icons",
    "@fortawesome/react-fontawesome",
    "@heroicons/react",
    "@mui/material",
    "@chakra-ui/react",
    "antd",
    "bootstrap",
    "react-icons"
  ],
  "sourceRoots": [
    "src"
  ],
  "rules": {
    "forbidHardcodedColorsOutsideTokenFiles": true,
    "forbidArbitraryTailwindHexColors": true,
    "preferExistingComponentsBeforeCreatingNewOnes": true,
    "requireResponsiveDesignForProductSurfaces": true,
    "requireAccessibleInteractivePrimitives": true,
    "requireVisualReviewForMaterialUiChanges": true,
    "forbidVisualInlineStyles": true,
    "forbidRawInteractiveElementsIn": [
      "src/app/",
      "src/features/"
    ],
    "forbiddenDecorationUtilities": [
      "backdrop-blur",
      "shadow-2xl",
      "rounded-[",
      "shadow-[",
      "bg-gradient-to-",
      "bg-linear-to-"
    ],
    "forbidLegacyMarketingPatterns": [
      "SessionPreview",
      "sr-stage-ring",
      "sr-stage-float",
      "sr-section-index",
      "srx-sheet",
      "srx-clause"
    ],
    "brandColorAllowed": true,
    "statusColorsSemanticOnly": true
  },
  "protectedSeoStyles": [
    "seo-article-publication-meta",
    "seo-article-citation",
    "seo-article-sources",
    "seo-article-table-wrap",
    "seo-article-index"
  ],
  "visualSourceOfTruth": "DESIGN.md",
  "layout": {
    "maxContentWidthPx": 1240,
    "desktopGutterPx": 32,
    "mobileGutterPx": 20,
    "sectionSpacingPx": {
      "min": 72,
      "max": 112
    },
    "readingWidthPx": {
      "min": 680,
      "max": 760
    },
    "hierarchy": [
      "page",
      "section",
      "container",
      "layout",
      "component",
      "element"
    ]
  },
  "typography": {
    "sansFamily": "IBM Plex Sans",
    "monoFamily": "JetBrains Mono",
    "displayUsesSans": true,
    "allowedWeights": [
      400,
      500,
      600,
      700
    ],
    "monoUse": [
      "commands",
      "code",
      "technical identifiers",
      "server and specification measurements"
    ],
    "semanticScale": {
      "pageTitle": "--text-page-title",
      "sectionTitle": "--text-section-title",
      "subsectionTitle": "--text-subsection-title",
      "cardTitle": "--text-card-title"
    },
    "homeHeroH1MayOverrideScale": true,
    "routeSpecificHeadingScalesDiscouraged": true
  }
}
