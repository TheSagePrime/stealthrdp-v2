{
  "schemaVersion": 1,
  "name": "Sage Prime frontend design contract",
  "componentSystem": {
    "name": "shadcn/ui",
    "configFile": "components.json",
    "style": "new-york",
    "uiAlias": "@/components/ui",
    "iconLibrary": "lucide",
    "primitiveRoot": "src/components/ui",
    "reservedPrimitiveFiles": [
      "button.tsx",
      "badge.tsx",
      "separator.tsx",
      "dropdown-menu.tsx",
      "input.tsx",
      "textarea.tsx",
      "select.tsx",
      "dialog.tsx",
      "card.tsx",
      "tabs.tsx",
      "tooltip.tsx"
    ]
  },
  "tokens": {
    "source": "src/styles/global.css",
    "required": [
      "--background",
      "--foreground",
      "--primary",
      "--primary-foreground",
      "--secondary",
      "--secondary-foreground",
      "--muted",
      "--muted-foreground",
      "--accent",
      "--accent-foreground",
      "--destructive",
      "--border",
      "--input",
      "--ring"
    ],
    "hardcodedColorAllowedPaths": [
      "src/styles/global.css"
    ]
  },
  "allowedIconPackages": [
    "lucide-react"
  ],
  "forbiddenUiPackages": [
    "@fortawesome/fontawesome-svg-core",
    "@fortawesome/free-solid-svg-icons",
    "@fortawesome/react-fontawesome",
    "@heroicons/react",
    "@mui/material",
    "@chakra-ui/react",
    "antd",
    "bootstrap",
    "react-icons"
  ],
  "sourceRoots": [
    "src"
  ],
  "rules": {
    "forbidHardcodedColorsOutsideTokenFiles": true,
    "forbidArbitraryTailwindHexColors": true,
    "preferExistingComponentsBeforeCreatingNewOnes": true,
    "requireResponsiveDesignForProductSurfaces": true,
    "requireAccessibleInteractivePrimitives": true,
    "requireVisualReviewForMaterialUiChanges": true,
    "forbidVisualInlineStyles": true,
    "forbidRawInteractiveElementsIn": [
      "src/app/",
      "src/features/"
    ],
    "forbiddenDecorationUtilities": [
      "backdrop-blur",
      "shadow-2xl",
      "rounded-[",
      "shadow-[",
      "bg-gradient-to-",
      "bg-linear-to-"
    ]
  },
  "protectedSeoStyles": [
    "seo-article-publication-meta",
    "seo-article-citation",
    "seo-article-sources",
    "seo-article-table-wrap",
    "seo-article-index"
  ],
  "visualRegression": {
    "engine": "vitest-browser-screenshot-sha256",
    "browser": "chromium",
    "platform": "linux",
    "references": {
      "desktopLight": {
        "viewport": [
          1024,
          900
        ],
        "sha256": "5895fa0aa4638ecb30f5aba76e8442b461c48a411f930a37ce71577228cabd5d"
      },
      "mobileLight": {
        "viewport": [
          390,
          844
        ],
        "sha256": "bcc2c382ef5ef86c340898709c66ed88bca95f511f118bf804e2ff63a953de69"
      },
      "desktopDark": {
        "viewport": [
          1024,
          900
        ],
        "sha256": "e232e937a51c0413a4fcfb74876cac6145e05dd3f43bdf0c42771a7518227cbc"
      }
    }
  }
}
