{
  "schemaVersion": 1,
  "name": "Sage Prime public web security and privacy contract",
  "privacy": {
    "sentryDefaultPii": false,
    "sentryReplayDefault": false,
    "browserLogsToTerminalDefault": false,
    "serverOnlyLoggingEnv": [
      "BETTER_STACK_INGESTING_URL",
      "BETTER_STACK_SOURCE_TOKEN",
      "LOGGING_LEVEL"
    ],
    "forbiddenPublicEnvPrefixes": [
      "NEXT_PUBLIC_BETTER_STACK_"
    ],
    "clientTelemetryOptInEnv": "NEXT_PUBLIC_SENTRY_ENABLED",
    "replayOptInEnv": "NEXT_PUBLIC_SENTRY_REPLAY_ENABLED",
    "e2eTracePolicy": "retain-on-failure",
    "maxDiagnosticArtifactRetentionDays": 1,
    "disableFrameworkTelemetryInCi": true,
    "sourceMapUploadOptInEnv": "SENTRY_SOURCE_MAP_UPLOAD_ENABLED",
    "sentryTunnelDefault": false,
    "componentAnnotationDefault": false
  },
  "http": {
    "requiredHeaders": [
      "Content-Security-Policy",
      "Cross-Origin-Opener-Policy",
      "Permissions-Policy",
      "Referrer-Policy",
      "X-Content-Type-Options",
      "X-Frame-Options"
    ],
    "productionRequiredHeaders": [
      "Strict-Transport-Security"
    ],
    "forbiddenCspFragments": [
      "clerk.com",
      "clerk.accounts.dev",
      "polar.sh",
      "stripe.com"
    ],
    "readinessCacheMs": 5000,
    "noStoreHealthEndpoints": true,
    "coalesceReadinessProbes": true
  },
  "supplyChain": {
    "packageManager": "pnpm",
    "forbiddenLockfiles": [
      "package-lock.json",
      "yarn.lock"
    ],
    "minimumDependencies": {
      "next": "16.3.3"
    },
    "requireFrozenLockfile": true,
    "requireDependencyAuditInCi": true,
    "pinGithubActionsToCommitSha": true,
    "forbiddenDependencies": [
      "@clerk/localizations",
      "@clerk/nextjs",
      "@clerk/shared",
      "@polar-sh/nextjs",
      "@polar-sh/sdk"
    ]
  },
  "database": {
    "directDbImportAllowedPrefixes": [
      "src/features/runtime/"
    ],
    "productionTlsRequired": true,
    "pool": {
      "max": 10,
      "connectionTimeoutMs": 5000,
      "queryTimeoutMs": 5000
    }
  },
  "seo": {
    "forbidProductionLocalAuditProxy": true,
    "escapeJsonLdScriptClosing": true
  },
  "serverOnlyModules": [
    "src/libs/Logger.ts",
    "src/utils/DBConnection.ts",
    "src/libs/DB.ts",
    "src/features/security/origin.ts",
    "src/features/security/rate-limit.ts",
    "src/features/security/response.ts"
  ],
  "release": {
    "requireCurrentMainSha": true
  },
  "publicExposure": {
    "policy": "Public frontend and SEO surfaces must never receive raw private or sensitive backend records.",
    "publicSourcePrefixes": [
      "src/app/[locale]/(marketing)/",
      "src/libs/seo/",
      "src/config/seo.ts",
      "src/app/robots.ts",
      "src/app/sitemap.ts",
      "src/app/rss.xml/"
    ],
    "forbiddenBackendImports": [
      "@/libs/DB",
      "@/utils/DBConnection",
      "@/models/Schema"
    ],
    "forbiddenSensitiveIdentifiers": [
      "password",
      "accessToken",
      "refreshToken",
      "sessionToken",
      "paymentMethodId",
      "cardNumber",
      "billingAddress"
    ],
    "rawSensitiveDataMayReachPublicFrontend": false,
    "backendMutationFromSeo": false,
    "requireAggregateOrDeidentifiedAnalyticsForPublishableSeoArtifacts": true,
    "publicRouteConvention": "All public App Router page/layout files are public surfaces unless a child project deliberately introduces a protected subsystem."
  }
}
