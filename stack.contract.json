{
  "schemaVersion": 1,
  "name": "Sage Prime public web stack",
  "purpose": "public-content-tools-traffic",
  "packageManager": {
    "name": "pnpm",
    "version": "10.34.5"
  },
  "runtime": {
    "node": ">=22",
    "framework": "next",
    "uiRuntime": "react",
    "language": "typescript"
  },
  "frontend": {
    "styling": "tailwindcss",
    "componentSystem": "shadcn/ui",
    "primitives": "radix-ui",
    "icons": [
      "@phosphor-icons/react",
      "@hugeicons/react",
      "@hugeicons/core-free-icons",
      "@icons-pack/react-simple-icons"
    ],
    "iconsLegacy": "lucide-react",
    "iconRules": "One family per component. Phosphor is primary; Hugeicons is a marketing accent only; brand marks come from Simple Icons or the official vendor SVG. Sizes 16/20/24/32. One stroke weight per surface. Decorative icons are aria-hidden; icon-only controls need an accessible name and a 44px hit area. No emoji as icons. lucide-react is legacy and must not be used for new work."
  },
  "database": {
    "engine": "postgresql",
    "productionProvider": "neon",
    "orm": "drizzle-orm",
    "runtimeDriver": "pg",
    "localProvider": "pglite"
  },
  "deployment": {
    "provider": "coolify"
  },
  "requiredDependencies": [
    "@hugeicons/core-free-icons",
    "@hugeicons/react",
    "@icons-pack/react-simple-icons",
    "@logtape/logtape",
    "@phosphor-icons/react",
    "class-variance-authority",
    "clsx",
    "drizzle-orm",
    "lucide-react",
    "next",
    "next-intl",
    "pg",
    "react",
    "react-dom",
    "server-only",
    "tailwind-merge",
    "zod"
  ],
  "requiredDevDependencies": [
    "@electric-sql/pglite",
    "@electric-sql/pglite-socket",
    "@tailwindcss/postcss",
    "drizzle-kit",
    "tailwindcss",
    "typescript"
  ],
  "forbiddenDependencies": [
    "@auth0/nextjs-auth0",
    "@clerk/localizations",
    "@clerk/nextjs",
    "@clerk/shared",
    "@clerk/ui",
    "@fortawesome/fontawesome-svg-core",
    "@fortawesome/free-solid-svg-icons",
    "@fortawesome/react-fontawesome",
    "@heroicons/react",
    "@mui/material",
    "@neondatabase/serverless",
    "@polar-sh/nextjs",
    "@polar-sh/sdk",
    "@prisma/client",
    "@supabase/supabase-js",
    "antd",
    "better-auth",
    "bootstrap",
    "firebase",
    "next-auth",
    "prisma",
    "react-icons",
    "sequelize",
    "typeorm"
  ],
  "forbiddenPaths": [
    "skills/saas-builder",
    "src/app/[locale]/(auth)",
    "src/app/api/polar",
    "src/features/billing",
    "src/features/dashboard",
    "src/features/data",
    "src/features/security/principal.ts",
    "src/features/security/routing.ts",
    "src/types/Auth.ts"
  ],
  "requiredFiles": [
    "components.json",
    "drizzle.config.ts",
    "src/styles/global.css",
    "src/utils/DBConnection.ts",
    "skills/web-builder/SKILL.md",
    "security.contract.json",
    "scripts/check-security-contract.mjs",
    "SECURITY.md"
  ],
  "seo": {
    "buildScript": "pnpm seo:pre-build && pnpm build:app && pnpm seo:post-build",
    "preBuildScript": "node --experimental-loader ./scripts/seo-ts-loader.mjs scripts/seo-pre-build.mjs",
    "postBuildScript": "node scripts/seo-post-build-runner.mjs",
    "requiredFiles": [
      "scripts/seo-lib.mjs",
      "scripts/seo-pre-build.mjs",
      "scripts/seo-post-build-runner.mjs",
      "scripts/seo-post-build-v2.mjs",
      "src/app/robots.ts",
      "src/app/sitemap.ts",
      "src/config/seo.ts",
      "src/libs/seo/metadata.ts",
      "src/libs/seo/project.ts",
      "src/libs/seo/articles.ts"
    ]
  }
}
